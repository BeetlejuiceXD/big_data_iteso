# Use these names inside Docker's spark-cluster_default network.
KAFKA_BOOTSTRAP_SERVERS=kafka:9093
KAFKA_TOPIC=trama-commerce-final-events
DB_HOST=trama-postgres-final
DB_PORT=5432
DB_NAME=trama_commerce_final
DB_USER=trama_final_user
DB_PASSWORD=replace-with-new-final-application-password
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
